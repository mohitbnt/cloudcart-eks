diff --git a/kubernetes/helm-charts/cloudcart/values-dev.yaml b/kubernetes/helm-charts/cloudcart/values-dev.yaml
index b22d392..dec1d20 100644
--- a/kubernetes/helm-charts/cloudcart/values-dev.yaml
+++ b/kubernetes/helm-charts/cloudcart/values-dev.yaml
@@ -14,6 +14,17 @@ imageTags:
   order: ""
   payment: ""
 
+# Dev shares the cluster with prod: cap it so a mistake here cannot starve production.
+# Sized for 9 pods (100m/256Mi requests, 500m/512Mi limits each) plus rolling-update surge.
+resourceQuota:
+  enabled: true
+  hard:
+    pods: "30"
+    requests.cpu: "3"
+    requests.memory: 6Gi
+    limits.cpu: "12"
+    limits.memory: 10Gi
+
 externalSecrets:
   postgresql:
     awsSecretName: cloudcart/dev/db-secrets
diff --git a/kubernetes/helm-charts/cloudcart/values.yaml b/kubernetes/helm-charts/cloudcart/values.yaml
index b541842..1478c49 100644
--- a/kubernetes/helm-charts/cloudcart/values.yaml
+++ b/kubernetes/helm-charts/cloudcart/values.yaml
@@ -11,6 +11,37 @@ global:
 # -----------------------------------------------------------------------------
 imageTags: {}
 
+# -----------------------------------------------------------------------------
+# Pod hardening (applied to every Deployment)
+# -----------------------------------------------------------------------------
+serviceAccount:
+  create: true
+  name: cloudcart # shared by all pods; the API token is NOT mounted
+
+# Backends run as `appuser` (UID 1000 in the python:3.12-slim images). The UID must be numeric
+# here because Kubernetes cannot verify runAsNonRoot for a user given only by name.
+podSecurityContext:
+  runAsNonRoot: true
+  runAsUser: 1000
+  runAsGroup: 1000
+  seccompProfile:
+    type: RuntimeDefault
+
+containerSecurityContext:
+  allowPrivilegeEscalation: false
+  readOnlyRootFilesystem: true # writable scratch space is the /tmp emptyDir only
+  capabilities:
+    drop: ["ALL"]
+
+podDisruptionBudget:
+  enabled: true
+  maxUnavailable: 1
+
+# Per-namespace resource cap (enabled in values-dev.yaml)
+resourceQuota:
+  enabled: false
+  hard: {}
+
 # -----------------------------------------------------------------------------
 # External Secrets Store
 # -----------------------------------------------------------------------------
@@ -48,7 +79,7 @@ networkPolicy:
   # egressTo: services it calls   postgres/redis: datastore access   scrape: has /metrics
   services:
     frontend:
-      port: 80
+      port: 8080 # pod port (the Service still exposes 80)
       fromAlb: true
     gateway:
       port: 8000
@@ -178,8 +209,16 @@ frontend:
   service:
     type: ClusterIP
     port: 80
-    targetPort: 80
-  
+    targetPort: 8080 # nginx-unprivileged listens on 8080 (non-root cannot bind port 80)
+
+  # nginx-unprivileged runs as the `nginx` user, UID 101
+  podSecurityContext:
