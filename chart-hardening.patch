+{{- end }}
diff --git a/kubernetes/helm-charts/cloudcart/templates/poddisruptionbudget.yaml b/kubernetes/helm-charts/cloudcart/templates/poddisruptionbudget.yaml
new file mode 100644
index 0000000..15588a2
--- /dev/null
+++ b/kubernetes/helm-charts/cloudcart/templates/poddisruptionbudget.yaml
@@ -0,0 +1,19 @@
+{{- if .Values.podDisruptionBudget.enabled }}
+{{- range $svc := list "frontend" "gateway" "cart" "catalog" "identity" "inventory" "notification" "order" "payment" }}
+---
+# Limits voluntary disruptions (node drains, upgrades) so a service never loses all replicas at once.
+# maxUnavailable (not minAvailable) so a single-replica service can still be drained.
+apiVersion: policy/v1
+kind: PodDisruptionBudget
+metadata:
+  name: cloudcart-{{ $svc }}-pdb
+  namespace: {{ $.Release.Namespace }}
+  labels:
+    {{- include "cloudcart.labels" $ | nindent 4 }}
+spec:
+  maxUnavailable: {{ $.Values.podDisruptionBudget.maxUnavailable }}
+  selector:
+    matchLabels:
+      {{- include "cloudcart.selectorLabels" $svc | nindent 6 }}
+{{- end }}
+{{- end }}
diff --git a/kubernetes/helm-charts/cloudcart/templates/resourcequota.yaml b/kubernetes/helm-charts/cloudcart/templates/resourcequota.yaml
new file mode 100644
index 0000000..58b4baf
--- /dev/null
+++ b/kubernetes/helm-charts/cloudcart/templates/resourcequota.yaml
@@ -0,0 +1,14 @@
+{{- if .Values.resourceQuota.enabled }}
+# Caps what this namespace can consume. Dev and prod share one cluster, so a runaway dev
+# deployment must not be able to starve production.
+apiVersion: v1
+kind: ResourceQuota
+metadata:
+  name: cloudcart-quota
+  namespace: {{ .Release.Namespace }}
+  labels:
+    {{- include "cloudcart.labels" . | nindent 4 }}
+spec:
+  hard:
+    {{- toYaml .Values.resourceQuota.hard | nindent 4 }}
+{{- end }}
diff --git a/kubernetes/helm-charts/cloudcart/templates/serviceaccount.yaml b/kubernetes/helm-charts/cloudcart/templates/serviceaccount.yaml
new file mode 100644
index 0000000..d529765
--- /dev/null
+++ b/kubernetes/helm-charts/cloudcart/templates/serviceaccount.yaml
@@ -0,0 +1,12 @@
+{{- if .Values.serviceAccount.create }}
+# One shared ServiceAccount for all CloudCart pods. The apps never call the Kubernetes API,
+# so the API token is not mounted into the pods.
+apiVersion: v1
+kind: ServiceAccount
+metadata:
+  name: {{ .Values.serviceAccount.name }}
+  namespace: {{ .Release.Namespace }}
+  labels:
+    {{- include "cloudcart.labels" . | nindent 4 }}
+automountServiceAccountToken: false
+{{- end }}
